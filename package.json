{
  "name": "headstock",
  "version": "1.0.0",
  "description": "Guitar tuner for Even Realities G2 smart glasses",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "pack": "npm run build && npx evenhub pack app.json dist --sdk-ver 0.0.14 -o headstock.ehpk",
    "sim": "evenhub-simulator -g --automation-port 9898 http://localhost:5173",
    "check:glyphs": "node scripts/check-glyphs.mjs",
    "gen:metrics": "node scripts/gen-metrics.mjs",
    "prebuild": "node scripts/gen-metrics.mjs",
    "check:detection": "esbuild scripts/check-detection.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-detection.mjs --log-level=error && node node_modules/.cache/check-detection.mjs",
    "check:layout": "esbuild scripts/check-layout.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-layout.mjs --log-level=error && node node_modules/.cache/check-layout.mjs",
    "check": "npm run check:docs && npm run check:glyphs && npm run check:layout && npm run check:detection && npm run check:robustness",
    "check:robustness": "esbuild scripts/check-robustness.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-robustness.mjs --log-level=error && node node_modules/.cache/check-robustness.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "guitar",
    "tuner",
    "even-realities",
    "g2",
    "smart-glasses"
  ],
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.14",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "@evenrealities/pretext": "^0.1.4",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smavromatis/headstock-g2.git"
  },
  "homepage": "https://github.com/smavromatis/headstock-g2#readme",
  "bugs": {
    "url": "https://github.com/smavromatis/headstock-g2/issues"
  }
}
